{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SWE Prep",
  "version": "0.1.0-preview.3",
  "identifier": "local.swe.interview-prep",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node tools/release/prepare-notices.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SWE Interview Prep",
        "width": 1280,
        "height": 850,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; font-src 'self' data:; media-src 'self' blob:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGM0Q0RDU2MDdENzU5M0IKUldRN1dkY0hWazA5NzhuZHpTTjQvTTRiNWRkNFB0cGxSUS8yZkRjeTJuRHc2ZFB6MkxwdWRVRU8K",
      "endpoints": [
        "https://github.com/kuochenwoo/intv-prep/releases/download/updates-preview/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
