{
  "name": "swe-interview-prep",
  "version": "0.1.0-preview.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "test:review-ui": "node --test tools/tests/review-ui.test.mjs",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "check:release": "node tools/release/check.mjs",
    "test:release-tools": "node --test tools/tests/release.test.mjs",
    "build:macos": "tauri build --target aarch64-apple-darwin --bundles app,dmg",
    "audit:release": "node tools/release/audit.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.0",
    "@astryxdesign/theme-neutral": "0.7.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@stylexjs/stylex": "^0.19.1",
    "@tauri-apps/api": "^2.0.0",
    "mermaid": "^12.2.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
