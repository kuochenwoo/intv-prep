# Development credential template. Copy to the ignored project .env; never commit it.
# Installed Release builds use their application-config .env, configured in Settings.
# Credentials are never loaded into process.env, SQLite, the frontend or release assets.
DEEPSEEK_API_KEY=
# OpenAI is used only for gpt-4o-mini-transcribe voice input.
# Interview questions, follow-ups and feedback use Claude or DeepSeek.
OPENAI_API_KEY=
CLAUDE_API_KEY=
