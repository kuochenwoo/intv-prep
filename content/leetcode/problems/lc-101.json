{
  "id": "lc-101",
  "title": "对称二叉树",
  "difficulty": "easy",
  "tags": [
    "树",
    "深度优先搜索",
    "广度优先搜索",
    "二叉树"
  ],
  "statement": "给定二叉树的根节点 root，判断它是否关于根节点轴对称：即左子树与右子树互为镜像（结构镜像且对应位置节点值相等）。\n\n节点定义：struct TreeNode { int val; TreeNode *left; TreeNode *right; }。输入中的树为 LeetCode 层序表示，null 表示空位。",
  "constraints": [
    "节点数在 [1, 1000] 范围内；-100 ≤ Node.val ≤ 100"
  ],
  "complexity": {
    "time": "O(n)",
    "space": "递归为 O(h) 递归栈；迭代队列为 O(w)。最坏 O(n)。",
    "officialRequirement": "官方未强制复杂度要求；follow-up 要求分别用递归和迭代两种方式实现。",
    "notes": "n 为节点数，h 为树高，w 为最大层宽。对称树节点数必为奇数，因此 1000 个节点的最大测试必然不对称；另含 999 个节点的对称 V 形双链与随机对称树。",
    "sourceUrl": "https://leetcode.com/problems/symmetric-tree/"
  },
  "cpp": {
    "functionTemplate": "/**\n * struct TreeNode {\n *     int val;\n *     TreeNode *left;\n *     TreeNode *right;\n * };\n */\nclass Solution {\npublic:\n    bool isSymmetric(TreeNode* root) {\n        return false; // Whether the tree mirrors itself around the root.\n    }\n};",
    "acmIoSpec": "stdin：第一行 m（层序 token 数）；第二行 m 个 token（整数或 null），为树的 LeetCode 层序表示。stdout：true 或 false。",
    "acmTemplate": "#include <iostream>\n#include <vector>\n#include <string>\n#include <algorithm>\n#include <unordered_map>\nusing namespace std;\n\nint main() {\n    // Read stdin and print the answer according to the problem protocol.\n    return 0;\n}\n"
  },
  "io": {
    "method": "isSymmetric",
    "params": [
      {
        "name": "root",
        "type": "TreeNode"
      }
    ],
    "returns": "bool"
  },
  "limits": {
    "timeLimitMs": 1000,
    "memoryLimitMb": 128,
    "outputLimitKb": 64
  },
  "examples": [
    {
      "input": "[1, 2, 2, 3, 4, 4, 3]",
      "output": "true"
    },
    {
      "input": "[1, 2, 2, null, 3, null, 3]",
      "output": "false"
    }
  ],
  "tests": [
    {"id": "t1", "logicalInput": [1, 2, 2, 3, 4, 4, 3], "expected": true, "isSample": true},
    {"id": "t2", "logicalInput": [1, 2, 2, null, 3, null, 3], "expected": false, "isSample": true},
    {"id": "single", "logicalInput": [0], "expected": true, "isSample": false},
    {"id": "two-nodes", "logicalInput": [1, 2], "expected": false, "isSample": false},
    {"id": "same-not-mirror", "logicalInput": [1, 2, 2, 3, null, 3], "expected": false, "isSample": false},
    {"id": "values-differ", "logicalInput": [1, 2, 3], "expected": false, "isSample": false},
